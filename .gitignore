# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Configuration & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Runtime Distributed Storage & Chunk Manifests
