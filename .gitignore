server/data/storage_nodes/
server/data/
*.chunk

# Logs & Runtime Diagnostics
*.log
logs/

# Operating System & Editor Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker Data
.docker/
docker-data/

# AI Agent Working Data
.gemini/
brain/
scratch/
