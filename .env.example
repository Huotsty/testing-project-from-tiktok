# ==============================================================================
# SysLab Dynamic Environment Configuration Template
# All parameters are 100% dynamic: override via environment variables or
# mutate dynamically on-the-fly at runtime via PATCH /api/config/:section!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 2. FLOCI LOCAL CLOUD ENGINE (AWS Port 4566 & UI Console Port 4500)
# ------------------------------------------------------------------------------
AWS_ENDPOINT_URL=http://localhost:4566
FLOCI_UI_URL=http://localhost:4500
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
FLOCI_S3_DEFAULT_BUCKET=syslab-cloud-bucket
FLOCI_SQS_DEFAULT_QUEUE=syslab-posts-queue
FLOCI_DYNAMO_DEFAULT_TABLE=SysLabFlags

# ------------------------------------------------------------------------------
# 3. DISTRIBUTED OBJECT STORAGE (S3-LITE CHUNKING & CAS)
# ------------------------------------------------------------------------------
STORAGE_DATA_DIR=./server/data/storage_nodes
STORAGE_NODES=node_a,node_b,node_c
STORAGE_REPLICATION_FACTOR=2
STORAGE_CHUNK_SIZE=64

# ------------------------------------------------------------------------------
# 4. SOCIAL POST & DELAYED EVENT SCHEDULER
# ------------------------------------------------------------------------------
SCHEDULER_WORKER_INTERVAL_MS=1000
SCHEDULER_MAX_RETRIES=3
SCHEDULER_FAILURE_RATE=0.0

# ------------------------------------------------------------------------------
# 5. API RATE LIMITER GATEWAY (TOKEN BUCKET / SLIDING WINDOW)
# ------------------------------------------------------------------------------
RATELIMIT_DEFAULT_ALGO=token_bucket
RATELIMIT_FREE_CAPACITY=5
RATELIMIT_FREE_REFILL_PER_SEC=0.5
RATELIMIT_PRO_CAPACITY=20
RATELIMIT_PRO_REFILL_PER_SEC=2.0

# ------------------------------------------------------------------------------
# 6. ACTIVITY FEED & FAN-OUT ARCHITECTURE
# ------------------------------------------------------------------------------
FEED_DEFAULT_FANOUT_MODE=hybrid
FEED_CELEBRITY_THRESHOLD=5

# ------------------------------------------------------------------------------
# 7. REAL-TIME TEAM SIMULATION & MULTI-AGENT COLLABORATION
# ------------------------------------------------------------------------------
TEAM_SIM_ACTIVE=true
TEAM_SIM_INTERVAL_MS=4500
