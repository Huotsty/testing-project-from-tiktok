# ==========================================
# SysLab: Environment Configuration Template
# Works seamlessly locally and in any cloud provider!
# ==========================================

# Server Listening Port & Host
PORT=3000
HOST=0.0.0.0

# Node Environment ('development' or 'production')
NODE_ENV=production

# Storage Persistence Path (Override for Docker Volume or AWS EBS mount)
# Default if unset: ./server/data/storage_nodes
STORAGE_DATA_DIR=/app/server/data/storage_nodes

# Optional Redis Distributed Backplane (for multi-instance clustering)
# Default if unset: in-memory engine runs seamlessly with zero external dependencies
REDIS_URL=redis://localhost:6379
